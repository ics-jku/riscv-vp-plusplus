# Embeds the GDB target description XML files into a C++ source file.
#
# Invoked at build time (see CMakeLists.txt) as:
#   cmake -DOUTPUT=<file.cpp> -DINPUTS=<a.xml;b.xml;...> -P embed_xml.cmake
#
# The generated file defines gdb_xml::files[] (see gdb_xml.h), one entry per XML file, keyed by its file name
# (= the annex GDB requests via qXfer:features:read). The content is emitted as a byte array, so the XML can contain
# any characters without breaking a string literal.

if(NOT OUTPUT OR NOT INPUTS)
	message(FATAL_ERROR "embed_xml.cmake: OUTPUT and INPUTS must be set")
endif()

set(names "")
set(arrays "")
set(entries "")
set(index 0)

foreach(input IN LISTS INPUTS)
	get_filename_component(name "${input}" NAME)
	list(APPEND names "${name}")

	file(READ "${input}" hex HEX)
	string(LENGTH "${hex}" hexlen)
	math(EXPR size "${hexlen} / 2")
	# "3c3f..." -> "0x3c,0x3f,..."
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

	string(APPEND arrays "// ${name}\nstatic const char data_${index}[] = {${bytes}};\n\n")
	string(APPEND entries "\t{\"${name}\", std::string_view(data_${index}, ${size})},\n")

	# collect xi:include references to check them below
	file(STRINGS "${input}" includes REGEX "xi:include")
	foreach(line IN LISTS includes)
		if(line MATCHES "href=\"([^\"]+)\"")
			list(APPEND refs "${name}:${CMAKE_MATCH_1}")
		endif()
	endforeach()

	math(EXPR index "${index} + 1")
endforeach()

# every included file must be embedded as well, otherwise GDB would fail at runtime
foreach(ref IN LISTS refs)
	string(REPLACE ":" ";" parts "${ref}")
	list(GET parts 0 from)
	list(GET parts 1 to)
	list(FIND names "${to}" found)
	if(found EQUAL -1)
		message(FATAL_ERROR "embed_xml.cmake: ${from} includes ${to}, which is not part of the embedded files")
	endif()
endforeach()

set(content "// Generated by embed_xml.cmake from gdb-mc/xml/*.xml, do not edit.\n\n")
string(APPEND content "#include \"core/common/gdb-mc/gdb_xml.h\"\n\nnamespace gdb_xml {\n\n")
string(APPEND content "${arrays}")
string(APPEND content "const XmlFile files[] = {\n${entries}};\n\n")
string(APPEND content "const size_t num_files = ${index};\n\n} /* namespace gdb_xml */\n")

# only touch the output if the content changed, avoids needless recompilation
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" old)
	if(old STREQUAL content)
		return()
	endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
